<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_OrderFulfillment"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.28.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.5.0">
  <bpmn:process id="order-fulfillment-process" name="Order Processing and Fulfilment Process" isExecutable="true">
    <bpmn:startEvent id="Start_OrderReceived" name="Order Placed">
      <bpmn:outgoing>Flow_Order_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_Order_1" sourceRef="Start_OrderReceived" targetRef="Task_ValidateAndCheckInventory" />

    <bpmn:serviceTask id="Task_ValidateAndCheckInventory" name="Validate Order &amp; Check Inventory">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-and-check-inventory" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Order_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Order_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_Order_2" sourceRef="Task_ValidateAndCheckInventory" targetRef="Gateway_StockCheck" />

    <bpmn:exclusiveGateway id="Gateway_StockCheck" name="Stock Available?">
      <bpmn:incoming>Flow_Order_2</bpmn:incoming>
      <bpmn:outgoing>Flow_StockIn</bpmn:outgoing>
      <bpmn:outgoing>Flow_StockOut</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_StockIn" name="Yes (In Stock)" sourceRef="Gateway_StockCheck" targetRef="Task_DeterminePriority">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_StockOut" name="No (Out of Stock)" sourceRef="Gateway_StockCheck" targetRef="Task_NotifyOutOfStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockAvailable = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_NotifyOutOfStock" name="Notify Out of Stock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-out-of-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StockOut</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndOutOfStock</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEndOutOfStock" sourceRef="Task_NotifyOutOfStock" targetRef="End_OutOfStock" />

    <bpmn:endEvent id="End_OutOfStock" name="Order Canceled (Stock Unavailable)">
      <bpmn:incoming>Flow_ToEndOutOfStock</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:businessRuleTask id="Task_DeterminePriority" name="Determine Order Priority">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="order-priority-decision" resultVariable="priorityResult" />
        <zeebe:ioMapping>
          <zeebe:output source="=priorityResult.priority" target="priority" />
          <zeebe:output source="=priorityResult.slaHours" target="slaHours" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StockIn</bpmn:incoming>
      <bpmn:outgoing>Flow_Order_3</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:sequenceFlow id="Flow_Order_3" sourceRef="Task_DeterminePriority" targetRef="Task_ProcessPayment" />

    <bpmn:serviceTask id="Task_ProcessPayment" name="Process Payment via REST Gateway" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://localhost:8080/api/payment/charge" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;, &#34;Accept&#34;: &#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={orderId: orderId, amount: orderTotal, paymentToken: paymentToken}" target="body" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:output source="=paymentResponse.body.paymentStatus" target="paymentStatus" />
          <zeebe:output source="=paymentResponse.body.transactionId" target="transactionId" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="resultVariable" value="paymentResponse" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Order_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Order_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_Order_4" sourceRef="Task_ProcessPayment" targetRef="Gateway_PaymentOutcome" />

    <bpmn:exclusiveGateway id="Gateway_PaymentOutcome" name="Payment Succeeded?">
      <bpmn:incoming>Flow_Order_4</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentSuccess</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_PaymentSuccess" name="Success" sourceRef="Gateway_PaymentOutcome" targetRef="Gateway_NeedsReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "SUCCESS"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_PaymentDeclined" name="Declined" sourceRef="Gateway_PaymentOutcome" targetRef="Task_NotifyPaymentDeclined">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus != "SUCCESS"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_NotifyPaymentDeclined" name="Notify Payment Failure">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-payment-failed" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentDeclined</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndDeclined</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEndDeclined" sourceRef="Task_NotifyPaymentDeclined" targetRef="End_PaymentDeclined" />

    <bpmn:endEvent id="End_PaymentDeclined" name="Order Canceled (Payment Declined)">
      <bpmn:incoming>Flow_ToEndDeclined</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_NeedsReview" name="Requires High-Value Verification?">
      <bpmn:incoming>Flow_PaymentSuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewRequired</bpmn:outgoing>
      <bpmn:outgoing>Flow_StandardFulfillment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_ReviewRequired" name="Review Needed (Total &gt;= 1000 or HIGH)" sourceRef="Gateway_NeedsReview" targetRef="Task_ManualOrderVerification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderTotal &gt;= 1000 or priority = "HIGH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_StandardFulfillment" name="Standard" sourceRef="Gateway_NeedsReview" targetRef="Gateway_FulfillJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderTotal &lt; 1000 and priority != "HIGH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:userTask id="Task_ManualOrderVerification" name="Manual Order Verification">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="sales-ops" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReviewRequired</bpmn:incoming>
      <bpmn:outgoing>Flow_Order_5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_Order_5" sourceRef="Task_ManualOrderVerification" targetRef="Gateway_ReviewResult" />

    <bpmn:exclusiveGateway id="Gateway_ReviewResult" name="Verification Approved?">
      <bpmn:incoming>Flow_Order_5</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReviewRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_ReviewApproved" name="Approved" sourceRef="Gateway_ReviewResult" targetRef="Gateway_FulfillJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderVerified = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ReviewRejected" name="Rejected" sourceRef="Gateway_ReviewResult" targetRef="Task_CancelOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderVerified = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_CancelOrder" name="Cancel &amp; Refund Order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cancel-order" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReviewRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndReviewRejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEndReviewRejected" sourceRef="Task_CancelOrder" targetRef="End_ReviewRejected" />

    <bpmn:endEvent id="End_ReviewRejected" name="Order Canceled (Verification Rejected)">
      <bpmn:incoming>Flow_ToEndReviewRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_FulfillJoin">
      <bpmn:incoming>Flow_StandardFulfillment</bpmn:incoming>
      <bpmn:incoming>Flow_ReviewApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFulfill</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_ToFulfill" sourceRef="Gateway_FulfillJoin" targetRef="Task_FulfillOrder" />

    <bpmn:serviceTask id="Task_FulfillOrder" name="Pack and Ship Order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fulfill-order" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFulfill</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndFulfilled</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEndFulfilled" sourceRef="Task_FulfillOrder" targetRef="End_Fulfilled" />

    <bpmn:endEvent id="End_Fulfilled" name="Order Successfully Fulfilled">
      <bpmn:incoming>Flow_ToEndFulfilled</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_OrderFulfillment">
    <bpmndi:BPMNPlane id="BPMNPlane_Order" bpmnElement="order-fulfillment-process">
      <bpmndi:BPMNShape id="Start_OrderReceived_di" bpmnElement="Start_OrderReceived">
        <dc:Bounds x="160" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="146" y="285" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ValidateAndCheckInventory_di" bpmnElement="Task_ValidateAndCheckInventory">
        <dc:Bounds x="250" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_StockCheck_di" bpmnElement="Gateway_StockCheck" isMarkerVisible="true">
        <dc:Bounds x="400" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="384" y="211" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_NotifyOutOfStock_di" bpmnElement="Task_NotifyOutOfStock">
        <dc:Bounds x="480" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_OutOfStock_di" bpmnElement="End_OutOfStock">
        <dc:Bounds x="630" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="611" y="405" width="75" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_DeterminePriority_di" bpmnElement="Task_DeterminePriority">
        <dc:Bounds x="500" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ProcessPayment_di" bpmnElement="Task_ProcessPayment">
        <dc:Bounds x="650" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_PaymentOutcome_di" bpmnElement="Gateway_PaymentOutcome" isMarkerVisible="true">
        <dc:Bounds x="800" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="793" y="205" width="65" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_NotifyPaymentDeclined_di" bpmnElement="Task_NotifyPaymentDeclined">
        <dc:Bounds x="880" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_PaymentDeclined_di" bpmnElement="End_PaymentDeclined">
        <dc:Bounds x="1030" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1009" y="405" width="79" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_NeedsReview_di" bpmnElement="Gateway_NeedsReview" isMarkerVisible="true">
        <dc:Bounds x="900" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="893" y="292" width="65" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ManualOrderVerification_di" bpmnElement="Task_ManualOrderVerification">
        <dc:Bounds x="1000" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ReviewResult_di" bpmnElement="Gateway_ReviewResult" isMarkerVisible="true">
        <dc:Bounds x="1150" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1147" y="85" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CancelOrder_di" bpmnElement="Task_CancelOrder">
        <dc:Bounds x="1250" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_ReviewRejected_di" bpmnElement="End_ReviewRejected">
        <dc:Bounds x="1400" y="42" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1379" y="85" width="79" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_FulfillJoin_di" bpmnElement="Gateway_FulfillJoin" isMarkerVisible="true">
        <dc:Bounds x="1220" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_FulfillOrder_di" bpmnElement="Task_FulfillOrder">
        <dc:Bounds x="1320" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_Fulfilled_di" bpmnElement="End_Fulfilled">
        <dc:Bounds x="1470" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1445" y="285" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Order_1_di" bpmnElement="Flow_Order_1">
        <di:waypoint x="196" y="260" />
        <di:waypoint x="250" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Order_2_di" bpmnElement="Flow_Order_2">
        <di:waypoint x="350" y="260" />
        <di:waypoint x="400" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_StockIn_di" bpmnElement="Flow_StockIn">
        <di:waypoint x="450" y="260" />
        <di:waypoint x="500" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="442" y="242" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_StockOut_di" bpmnElement="Flow_StockOut">
        <di:waypoint x="425" y="285" />
        <di:waypoint x="425" y="380" />
        <di:waypoint x="480" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="330" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToEndOutOfStock_di" bpmnElement="Flow_ToEndOutOfStock">
        <di:waypoint x="580" y="380" />
        <di:waypoint x="630" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Order_3_di" bpmnElement="Flow_Order_3">
        <di:waypoint x="600" y="260" />
        <di:waypoint x="650" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Order_4_di" bpmnElement="Flow_Order_4">
        <di:waypoint x="750" y="260" />
        <di:waypoint x="800" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_PaymentSuccess_di" bpmnElement="Flow_PaymentSuccess">
        <di:waypoint x="850" y="260" />
        <di:waypoint x="900" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="854" y="242" width="43" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_PaymentDeclined_di" bpmnElement="Flow_PaymentDeclined">
        <di:waypoint x="825" y="285" />
        <di:waypoint x="825" y="380" />
        <di:waypoint x="880" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="831" y="330" width="43" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToEndDeclined_di" bpmnElement="Flow_ToEndDeclined">
        <di:waypoint x="980" y="380" />
        <di:waypoint x="1030" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ReviewRequired_di" bpmnElement="Flow_ReviewRequired">
        <di:waypoint x="925" y="235" />
        <di:waypoint x="925" y="140" />
        <di:waypoint x="1000" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="933" y="160" width="77" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_StandardFulfillment_di" bpmnElement="Flow_StandardFulfillment">
        <di:waypoint x="950" y="260" />
        <di:waypoint x="1220" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1062" y="242" width="45" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Order_5_di" bpmnElement="Flow_Order_5">
        <di:waypoint x="1100" y="140" />
        <di:waypoint x="1150" y="140" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ReviewApproved_di" bpmnElement="Flow_ReviewApproved">
        <di:waypoint x="1175" y="165" />
        <di:waypoint x="1175" y="260" />
        <di:waypoint x="1220" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1182" y="196" width="47" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ReviewRejected_di" bpmnElement="Flow_ReviewRejected">
        <di:waypoint x="1175" y="115" />
        <di:waypoint x="1175" y="60" />
        <di:waypoint x="1250" y="60" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1184" y="85" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToEndReviewRejected_di" bpmnElement="Flow_ToEndReviewRejected">
        <di:waypoint x="1350" y="60" />
        <di:waypoint x="1400" y="60" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToFulfill_di" bpmnElement="Flow_ToFulfill">
        <di:waypoint x="1270" y="260" />
        <di:waypoint x="1320" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToEndFulfilled_di" bpmnElement="Flow_ToEndFulfilled">
        <di:waypoint x="1420" y="260" />
        <di:waypoint x="1470" y="260" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>